import React, { useEffect, useRef, useState } from 'react';
import { FlatList, Platform, useWindowDimensions, View, ViewToken } from 'react-native';
import { useIsFocused } from '@react-navigation/native';
import { useBottomTabBarHeight } from '@react-navigation/bottom-tabs';
import VideoItem from '../../components/VideoItem';
import PaywallModal from '../../components/PaywallModal';
import { SIDEBAR_WIDTH } from '../../components/Sidebar';
import { useWallet } from '../../context/WalletContext';
import { useIsDesktop } from '../../hooks/useIsDesktop';
import { FREE_EPISODES_LIMIT, MOCK_VIDEOS, Video } from '../../data/mockVideos';
import { notify } from '../../utils/notify';

const VIEWABILITY_CONFIG = { itemVisiblePercentThreshold: 60 };

export default function FeedScreen() {
  const { width, height } = useWindowDimensions();
  const measuredTabBarHeight = useBottomTabBarHeight();
  const isDesktop = useIsDesktop();
  const isFocused = useIsFocused();

  // Sur web grand écran, il n'y a pas de barre inférieure et la barre latérale réduit la largeur.
  const tabBarHeight = isDesktop ? 0 : measuredTabBarHeight;
  const itemHeight = height - tabBarHeight;
  const availableWidth = isDesktop ? width - SIDEBAR_WIDTH : width;
  // Sur grand écran, la vidéo garde son format 9:16 et reste centrée.
  const itemWidth = isDesktop ? Math.min((itemHeight * 9) / 16, availableWidth) : availableWidth;

  const { addCoins, spendCoins, unlockEpisode, isUnlocked } = useWallet();

  const listRef = useRef<FlatList<Video>>(null);
  const [activeIndex, setActiveIndex] = useState(0);
  const activeRef = useRef(0);
  const [dismissedId, setDismissedId] = useState<string | null>(null);

  const currentVideo = MOCK_VIDEOS[activeIndex];
  const isLocked = (index: number) =>
    index >= FREE_EPISODES_LIMIT && !isUnlocked(MOCK_VIDEOS[index].id);
  const paywallVisible = isLocked(activeIndex) && dismissedId !== currentVideo.id;

  const onViewableItemsChanged = useRef(
    ({ viewableItems }: { viewableItems: ViewToken[] }) => {
      const first = viewableItems[0];
      if (first && first.index != null) {
        activeRef.current = first.index;
        setActiveIndex(first.index);
      }
    }
  ).current;

  // Web : navigation clavier (flèches haut/bas, Page précédente/suivante)
  useEffect(() => {
    if (Platform.OS !== 'web' || !isFocused) return;
    const w = globalThis as any;

    const onKey = (e: any) => {
      const tag = e.target?.tagName;
      if (tag === 'INPUT' || tag === 'TEXTAREA') return;

      let delta = 0;
      if (e.key === 'ArrowDown' || e.key === 'PageDown') delta = 1;
      else if (e.key === 'ArrowUp' || e.key === 'PageUp') delta = -1;
      else return;

      e.preventDefault();
      const next = Math.min(Math.max(activeRef.current + delta, 0), MOCK_VIDEOS.length - 1);
      listRef.current?.scrollToIndex({ index: next, animated: true });
    };

    w.addEventListener('keydown', onKey);
    return () => w.removeEventListener('keydown', onKey);
  }, [isFocused]);

  const unlockCurrent = () => {
    unlockEpisode(currentVideo.id);
    setDismissedId(null);
  };

  const handleWatchAd = () => {
    notify('Publicité', 'Simulation : publicité terminée. Épisode débloqué !');
    unlockCurrent();
  };

  const handleBuyCoins = () => {
    addCoins(100);
    notify('Achat simulé', '+100 pièces ajoutées et épisode débloqué.');
    unlockCurrent();
  };

  const handleTip = () => {
    if (spendCoins(5)) {
      notify('Merci !', 'Vous avez offert 5 pièces au créateur.');
    } else {
      notify('Solde insuffisant', 'Rechargez vos pièces dans votre profil.');
    }
  };

  return (
    <View style={{ flex: 1, backgroundColor: '#000', alignItems: 'center' }}>
      <FlatList
        ref={listRef}
        style={{ width: itemWidth, height: itemHeight }}
        data={MOCK_VIDEOS}
        keyExtractor={(item) => item.id}
        renderItem={({ item, index }) => (
          <VideoItem
            video={item}
            width={itemWidth}
            height={itemHeight}
            isActive={index === activeIndex && isFocused && !paywallVisible}
            locked={isLocked(index)}
            onTip={handleTip}
          />
        )}
        getItemLayout={(_, index) => ({
          length: itemHeight,
          offset: itemHeight * index,
          index,
        })}
        snapToInterval={itemHeight}
        snapToAlignment="start"
        decelerationRate="fast"
        showsVerticalScrollIndicator={false}
        onViewableItemsChanged={onViewableItemsChanged}
        viewabilityConfig={VIEWABILITY_CONFIG}
      />

      <PaywallModal
        visible={paywallVisible}
        seriesTitle={currentVideo.seriesTitle}
        episode={currentVideo.episode}
        onWatchAd={handleWatchAd}
        onBuyCoins={handleBuyCoins}
        onClose={() => setDismissedId(currentVideo.id)}
      />
    </View>
  );
}